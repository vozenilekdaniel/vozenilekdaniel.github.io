<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slepá mapa - Afrika</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        body { margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; display: flex; flex-direction: column; height: 100vh; background-color: #121212; color: white; }
        #header { padding: 15px 20px; background-color: #1e1e1e; box-shadow: 0 2px 5px rgba(0,0,0,0.5); z-index: 1000; display: flex; justify-content: space-between; align-items: center; }
        #question-box { font-size: 24px; font-weight: bold; }
        #target-name { color: #4caf50; font-size: 28px; }
        #stats { font-size: 18px; color: #aaa; text-align: right; }
        
        #content { display: flex; flex: 1; overflow: hidden; }
        #map { flex: 1; cursor: crosshair; }
        .leaflet-container { background: #000; }
        
        #sidebar { width: 300px; background-color: #1a1a1a; border-left: 2px solid #333; display: flex; flex-direction: column; }
        #sidebar-header { padding: 15px; font-weight: bold; font-size: 18px; background: #222; border-bottom: 1px solid #333; }
        #history { flex: 1; overflow-y: auto; padding: 10px; list-style: none; margin: 0; }
        .history-item { padding: 8px 10px; margin-bottom: 5px; border-radius: 4px; font-size: 16px; background-color: #2a2a2a; display: flex; justify-content: space-between; }
        .correct { border-left: 4px solid #4caf50; }
        .incorrect { border-left: 4px solid #f44336; }
        .status-icon { font-weight: bold; }
        .correct .status-icon { color: #4caf50; }
        .incorrect .status-icon { color: #f44336; }
    </style>
</head>
<body>
    <div id="header">
        <div id="question-box">Kde je: <span id="target-name">Načítání...</span></div>
        <div id="stats">
            Uhodnuto: <span id="score" style="color: #4caf50;">0</span> / <span id="total">0</span><br>
            <span style="font-size: 14px; color: #888;">Chyby: <span id="mistakes">0</span></span>
        </div>
    </div>
    <div id="content">
        <div id="map"></div>
        <div id="sidebar">
            <div id="sidebar-header">Historie pokusů</div>
            <ul id="history"></ul>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const locations = [
            { name: "Madeira", lat: 32.7, lng: -17.0, r: 250 },
            { name: "Svatá Helena", lat: -15.9, lng: -5.7, r: 250 },
            { name: "Bioko", lat: 3.5, lng: 8.7, r: 200 },
            { name: "Zanzibar", lat: -6.1, lng: 39.3, r: 200 },
            { name: "Madagaskar", lat: -19.0, lng: 47.0, r: 500 },
            { name: "Mauricius", lat: -20.3, lng: 57.5, r: 250 },
            { name: "Réunion", lat: -21.1, lng: 55.5, r: 250 },
            { name: "Kanárské ostrovy", lat: 28.2, lng: -16.6, r: 350 },
            { name: "Kapverdy", lat: 16.0, lng: -24.0, r: 350 },
            { name: "Maskarény", lat: -20.0, lng: 57.0, r: 400 },
            { name: "Komory", lat: -11.8, lng: 43.8, r: 300 },
            { name: "Seychely", lat: -4.6, lng: 55.4, r: 400 },
            { name: "Sokotra", lat: 12.5, lng: 53.8, r: 250 },
            { name: "Somálský poloostrov", lat: 9.0, lng: 48.0, r: 600 },
            { name: "Atlantský oceán", lat: 0.0, lng: -15.0, r: 1500 },
            { name: "Indický oceán", lat: -10.0, lng: 60.0, r: 1500 },
            { name: "Rudé moře", lat: 20.0, lng: 38.0, r: 500 },
            { name: "Středozemní moře", lat: 34.0, lng: 18.0, r: 800 },
            { name: "Guinejský záliv", lat: 2.0, lng: 3.0, r: 600 },
            { name: "Adenský záliv", lat: 12.0, lng: 48.0, r: 400 },
            { name: "Velká Syrta", lat: 31.5, lng: 18.0, r: 350 },
            { name: "Gibraltarský průliv", lat: 35.9, lng: -5.5, r: 250 },
            { name: "Mosambický průliv", lat: -18.0, lng: 40.0, r: 600 },
            { name: "Bab-al-Mandab", lat: 12.5, lng: 43.3, r: 250 },
            { name: "Suezský průplav", lat: 30.6, lng: 32.3, r: 200 },
            { name: "Atlas", lat: 32.0, lng: -4.0, r: 600 },
            { name: "Adamauské hory", lat: 6.0, lng: 12.0, r: 400 },
            { name: "Dračí hory", lat: -29.0, lng: 29.0, r: 400 },
            { name: "Etiopská vysočina", lat: 10.0, lng: 38.0, r: 500 },
            { name: "Východoafrická vysočina", lat: -2.0, lng: 33.0, r: 600 },
            { name: "Čadská pánev", lat: 13.0, lng: 16.0, r: 600 },
            { name: "Konžská pánev", lat: -1.0, lng: 21.0, r: 700 },
            { name: "Sahara", lat: 23.0, lng: 10.0, r: 1200 },
            { name: "Namib", lat: -23.0, lng: 15.0, r: 500 },
            { name: "Kalahari", lat: -23.0, lng: 22.0, r: 600 },
            { name: "Nil", lat: 18.0, lng: 32.0, r: 800 },
            { name: "Kagera", lat: -1.0, lng: 30.0, r: 300 },
            { name: "Kongo", lat: -1.0, lng: 18.0, r: 700 },
            { name: "Niger", lat: 14.0, lng: 0.0, r: 700 },
            { name: "Zambezi", lat: -16.0, lng: 28.0, r: 600 },
            { name: "Orange", lat: -29.0, lng: 20.0, r: 500 },
            { name: "Čadské jezero", lat: 13.0, lng: 14.0, r: 300 },
            { name: "Tana", lat: 12.0, lng: 37.3, r: 200 },
            { name: "Albertovo jezero", lat: 1.5, lng: 30.5, r: 200 },
            { name: "Rudolfovo jezero (Turkana)", lat: 3.5, lng: 36.0, r: 250 },
            { name: "Viktoriino jezero", lat: -1.0, lng: 33.0, r: 350 },
            { name: "Tanganika", lat: -6.0, lng: 29.5, r: 400 },
            { name: "Malawi", lat: -12.0, lng: 34.5, r: 350 },
            { name: "Přehradní nádrž Volta", lat: 8.0, lng: 0.0, r: 250 },
            { name: "Asuánská přehrada", lat: 23.9, lng: 32.9, r: 250 },
            { name: "Přehradní nádrž Kariba", lat: -16.5, lng: 28.7, r: 250 },
            { name: "Viktoriiny vodopády", lat: -17.9, lng: 25.8, r: 200 }
        ];

        // Pracovní pole - zkopírujeme a zamícháme
        let queue = [...locations];
        queue.sort(() => Math.random() - 0.5);

        const totalItems = locations.length;
        let score = 0;
        let mistakes = 0;
        let mapLocked = false;
        let currentMarker = null;

        const map = L.map('map', { maxBounds: [[39, -20], [-40, 60]], maxBoundsViscosity: 1.0 }).setView([0, 20], 4);

        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            attribution: 'Tiles &copy; Esri'
        }).addTo(map);

        const targetEl = document.getElementById('target-name');
        const scoreEl = document.getElementById('score');
        const totalEl = document.getElementById('total');
        const mistakesEl = document.getElementById('mistakes');
        const historyEl = document.getElementById('history');

        totalEl.textContent = totalItems;

        function logHistory(name, isCorrect) {
            const li = document.createElement('li');
            li.className = 'history-item ' + (isCorrect ? 'correct' : 'incorrect');
            li.innerHTML = `<span>${name}</span> <span class="status-icon">${isCorrect ? '✔' : '✖'}</span>`;
            // Přidat na začátek seznamu (nejnovější nahoře)
            historyEl.insertBefore(li, historyEl.firstChild);
        }

        function loadQuestion() {
            if (queue.length === 0) {
                targetEl.textContent = `Hotovo! Vše uhodnuto. (Chyb: ${mistakes})`;
                targetEl.style.color = "#ffeb3b";
                return;
            }
            // Vždy se ptáme na první prvek ve frontě
            targetEl.textContent = queue[0].name;
            targetEl.style.color = "#4caf50";
            mapLocked = false;
        }

        map.on('click', function(e) {
            if (mapLocked || queue.length === 0) return;
            mapLocked = true;

            const target = queue[0];
            const clickLatLng = e.latlng;
            const targetLatLng = L.latLng(target.lat, target.lng);
            
            const distance = clickLatLng.distanceTo(targetLatLng);
            const tolerance = target.r * 1000;

            if (currentMarker) map.removeLayer(currentMarker);

            if (distance <= tolerance) {
                score++;
                scoreEl.textContent = score;
                targetEl.textContent = "Správně!";
                
                // Odebrání z fronty, protože je to správně
                queue.shift();
                logHistory(target.name, true);
                
                currentMarker = L.circle(targetLatLng, { color: 'green', fillColor: '#0f0', fillOpacity: 0.5, radius: tolerance }).addTo(map);
            } else {
                mistakes++;
                mistakesEl.textContent = mistakes;
                targetEl.textContent = "Špatně. Bylo to zde:";
                targetEl.style.color = "#f44336";
                
                // Přesun nakonec fronty pro budoucí zopakování
                queue.push(queue.shift());
                logHistory(target.name, false);

                currentMarker = L.layerGroup([
                    L.circleMarker(clickLatLng, { color: 'red', radius: 5 }),
                    L.circle(targetLatLng, { color: 'blue', fillColor: '#00f', fillOpacity: 0.3, radius: tolerance })
                ]).addTo(map);
            }

            // Pauza na prohlédnutí výsledku
            setTimeout(() => {
                if (currentMarker) map.removeLayer(currentMarker);
                loadQuestion();
            }, 1800); // Mírně prodlouženo na 1.8s, ať si stihneš prohlédnout chybu
        });

        loadQuestion();
    </script>
</body>
</html>
